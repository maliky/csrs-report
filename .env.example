COMPOSE_PROJECT_NAME=csrs
CSRS_BIND_ADDRESS=127.0.0.1
CSRS_PORT=18005
CSRS_HOST=csrs.koba.sarl
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,csrs.koba.sarl
DJANGO_CSRF_TRUSTED_ORIGINS=https://csrs.koba.sarl
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
OBSERVABLE_EXPORT_TOKEN_MAX_AGE_SECONDS=900
DATABASE_URL=postgresql://csrs:change-me@db:5432/csrs
POSTGRES_DB=csrs
POSTGRES_USER=csrs
POSTGRES_PASSWORD=change-me
EMAIL_HOST=mail.koba.sarl
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CSRS Report <noreply@koba.sarl>
PROCESS_DOCUMENT_BACKEND=local
PROCESS_DOCUMENT_ROOT=/private-media
PROCESS_DOCUMENT_MAX_BYTES=20971520
PROCESS_DOCUMENT_SCAN_REQUIRED=1
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=15
# Pour SharePoint, utiliser PROCESS_DOCUMENT_BACKEND=sharepoint et renseigner ces secrets dans .env uniquement.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_SITE_ID=
MICROSOFT_GRAPH_DRIVE_ID=
MICROSOFT_GRAPH_FOLDER=CSRS-Report
